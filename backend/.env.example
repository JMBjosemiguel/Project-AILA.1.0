NODE_ENV=production
PORT=5000
APP_URL=https://your-cloudflare-pages-site.pages.dev
CORS_ORIGINS=https://your-cloudflare-pages-site.pages.dev

# IANA timezone used for streak "days" and the weekly leaderboard week boundary.
# There is no per-user timezone; this is the whole app's calendar. Unset or an
# invalid value falls back to UTC. Set it to the deployment's locale.
APP_TIMEZONE=Asia/Manila

DB_HOST=your-aiven-mysql-host
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=replace-with-aiven-password
DB_NAME=aila_db
DB_CONNECTION_LIMIT=5
DB_SSL=true
DB_SSL_CA=replace-with-aiven-ca-certificate-or-leave-empty-if-provider-uses-public-ca
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

STORAGE_DRIVER=r2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=aila-resources
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com

# Outbound email (registration verification links). 'console' logs instead of
# sending — safe for local dev, never use it in production. 'smtp' sends via
# nodemailer over generic SMTP (works with any provider: SendGrid, Mailgun,
# SES, a transactional-email relay, ...). SMTP_* below are only read when
# EMAIL_DRIVER=smtp.
EMAIL_DRIVER=smtp
EMAIL_FROM=AILA <no-reply@your-domain.example>
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
